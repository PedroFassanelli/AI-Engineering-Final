# Copiá este archivo a .env y completá las claves (run.sh / run.ps1 lo copian solos).
#   Windows:      Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# El .env está en .gitignore: nunca se sube al repositorio.
# Nada de lo configurable está escrito en el código: índices, modelos y límites
# salen de acá, con defaults en app/config.py.

# --- Claves (obligatorias) ----------------------------------------------------
# OpenAI: chat (si PROVEEDOR=openai) y SIEMPRE los embeddings del RAG.
OPENAI_API_KEY=
# Pinecone: https://app.pinecone.io -> API Keys (empieza con pcsk_). El plan
# gratuito alcanza. No hace falta crear el índice: el worker lo crea solo.
PINECONE_API_KEY=
# Solo si PROVEEDOR=anthropic.
ANTHROPIC_API_KEY=

# --- Proveedor del LLM -----------------------------------------------------------
# openai | anthropic
PROVEEDOR=openai
# Modelo de especialistas, sintetizador y planificador. Vacío = default:
#   openai -> gpt-4o-mini   |   anthropic -> claude-haiku-4-5
MODELO=
# Modelo del supervisor (el único rol que decide el flujo). Vacío = MODELO.
MODELO_SUPERVISOR=gpt-4o
TEMPERATURA=0

# --- RAG: Pinecone (vectorial) + BM25 (léxico) -----------------------------------
# hibrido | lexico   (lexico = solo BM25, sin Pinecone ni embeddings; peor calidad)
RAG_MODO=hibrido
INDEX_NAME=nimbus-sdk-docs
PINECONE_NAMESPACE=nimbus-sdk-final
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# La dimensión NO se configura: se deriva del modelo (1536 para este).
EMBEDDING_MODEL=text-embedding-3-small
# Chunking: por sección de Markdown; las secciones más largas que esto se parten.
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
# Pesos de la fusión RRF (medidos en la Pre-entrega 4; re-medir con
# `python -m app.cli evaluar-rag`).
PESO_BM25=0.3
PESO_VECTORIAL=0.7
RAG_CANDIDATOS=10
RAG_TOP_K=3

# --- Conversaciones ---------------------------------------------------------------
# Turnos anteriores que ven los agentes para resolver referencias.
HISTORIAL_MAX_TURNOS=4
# Vida de una conversación (checkpoints + registro) desde su último uso: 7 días.
TTL_CONVERSACION_SEGUNDOS=604800

# --- Condiciones de parada del orquestador ------------------------------------------
MAX_PASOS_SUPERVISOR=6
MAX_RONDAS_POR_AGENTE=2
LIMITE_RECURSION_ESPECIALISTA=12

# --- Redis: jobs, conversaciones, cola de Arq y checkpoints de LangGraph -------------
# Con docker compose, la API y el worker usan redis://redis:6379/0 (lo pisa el
# compose). Este valor es para correrlos fuera de Docker.
REDIS_URL=redis://localhost:6379/0
# Vida de un job (un turno) desde su última actualización.
TTL_JOB_SEGUNDOS=86400

# --- Worker -------------------------------------------------------------------------
# Tiempo máximo de una corrida del grafo. Pasado eso: FAILED.
TIMEOUT_TAREA_SEGUNDOS=300
# Corrutinas simultáneas por proceso worker.
MAX_TAREAS_CONCURRENTES=10

# --- Human-in-the-loop ----------------------------------------------------------------
# Toda acción con efectos pide aprobación. Estos umbrales agregan razones
# ("monto alto", "acción masiva") a lo que ve quien aprueba.
UMBRAL_MONTO_ALTO_CENTAVOS=1000000
UMBRAL_PAGOS_MASIVO=3

# --- Observabilidad (Arize Phoenix) -----------------------------------------------------
TRAZAS_ACTIVAS=1
# Con docker compose lo pisa el compose (http://phoenix:6006/v1/traces).
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=nimbus-intelligence
